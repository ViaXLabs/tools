## ============================================================
## Harness Pipeline: Splunk On-Call Maintenance Mode Automation
## ============================================================
##
## WHAT THIS DOES:
##   PRE-DEPLOY  → Starts a Splunk On-Call maintenance window via API
##   DEPLOY      → Runs your existing deployment steps
##   POST-DEPLOY → (1) Fetches open incidents started after deploy began
##                 (2) Resolves those incidents
##                 (3) Ends the maintenance window
##
## IMPORTANT: Incidents are resolved BEFORE ending maintenance mode.
##   Ending maintenance mode first would immediately page on-call engineers
##   for any still-open incidents. This order prevents that.
##
## REQUIRED HARNESS SECRETS (set before using this pipeline):
##   splunk_oncall_api_id      → Your API ID  (Integrations → API in Splunk On-Call)
##   splunk_oncall_api_key     → Your API Key
##   splunk_oncall_username    → A valid Splunk On-Call user in your org (used for resolve authorship)
##
## REQUIRED EDITS before use (search for "CHANGE_ME"):
##   1. connectorRef      → Your Harness connector for the deploy service
##   2. routing key names → Your actual routing key(s) or switch to Global mode
##   3. Deploy stage      → Replace placeholder steps with your real deploy steps
## ============================================================

pipeline:
  name: Deploy with Splunk On-Call Maintenance
  identifier: deploy_with_splunk_oncall_maintenance
  projectIdentifier: CHANGE_ME_project
  orgIdentifier: CHANGE_ME_org
  description: >
    Wraps deployments with automated Splunk On-Call maintenance mode management.
    Starts a maintenance window before deploy, then resolves ghost alerts and
    ends the window cleanly after deploy completes.
  tags:
    oncall: managed
    maintenance: automated

  variables:
    ## Override these at runtime or set defaults here
    - name: routing_keys
      type: String
      default: "CHANGE_ME_your_routing_key"
      description: >
        Comma-separated routing key(s) to mute during maintenance.
        Leave empty ("") to trigger a GLOBAL maintenance mode (mutes everything).
    - name: maintenance_purpose
      type: String
      default: "Harness automated deployment"
      description: Label shown in the Splunk On-Call UI for this maintenance window.

  stages:

    ## ──────────────────────────────────────────────────────────
    ## STAGE 1: Pre-Deploy — Start Maintenance Mode
    ## ──────────────────────────────────────────────────────────
    - stage:
        name: Start Maintenance Mode
        identifier: start_maintenance_mode
        type: Custom
        spec:
          execution:
            steps:

              - step:
                  name: Start Splunk On-Call Maintenance Mode
                  identifier: start_maintenance_mode_api
                  type: Http
                  spec:
                    method: POST
                    url: https://api.victorops.com/api-public/v1/maintenancemode/start
                    headers:
                      - key: X-VO-Api-Id
                        value: <+secrets.getValue("splunk_oncall_api_id")>
                      - key: X-VO-Api-Key
                        value: <+secrets.getValue("splunk_oncall_api_key")>
                      - key: Content-Type
                        value: application/json
                    requestBody: |-
                      {
                        "purpose": "<+pipeline.variables.maintenance_purpose> | Pipeline: <+pipeline.name> | RunID: <+pipeline.executionId>",
                        "type": "RoutingKeys",
                        "names": ["<+pipeline.variables.routing_keys>"]
                      }
                    ## NOTE: For GLOBAL maintenance mode (mute everything), replace the body above with:
                    ##   { "purpose": "...", "type": "Global", "names": [] }
                    ##
                    ## NOTE: For multiple routing keys, expand the names array:
                    ##   "names": ["payments-team", "api-gateway", "auth-service"]
                    assertion: <+httpResponseCode> == 200
                    outputVariables:
                      - name: maintenanceModeId
                        value: <+json("activeInstances[0].instanceId")>
                        type: String
                  timeout: 30s
                  failureStrategies:
                    - onFailure:
                        errors:
                          - AllErrors
                        action:
                          type: Abort
                  description: >
                    Starts a Splunk On-Call maintenance window and captures the
                    instanceId for use when ending the window post-deploy.

    ## ──────────────────────────────────────────────────────────
    ## STAGE 2: Deploy — Your Existing Deployment Logic
    ## ──────────────────────────────────────────────────────────
    - stage:
        name: Deploy
        identifier: deploy
        type: Deployment
        ## !! CHANGE_ME: Replace this entire stage spec with your real deployment.
        ## This is a placeholder showing where your deploy steps live.
        ## Your existing Harness pipeline's deploy stage goes here unchanged.
        spec:
          deploymentType: Kubernetes   ## CHANGE_ME: match your service type
          service:
            serviceRef: CHANGE_ME_service
          environment:
            environmentRef: CHANGE_ME_environment
            deployToAll: false
            infrastructureDefinitions:
              - identifier: CHANGE_ME_infra
          execution:
            steps:
              - step:
                  name: Deploy Service
                  identifier: deploy_service
                  type: K8sRollingDeploy   ## CHANGE_ME: match your deploy step type
                  timeout: 10m
                  spec:
                    skipDryRun: false
            rollbackSteps:
              - step:
                  name: Rollback
                  identifier: rollback
                  type: K8sRollingRollback
                  timeout: 10m
                  spec: {}
        failureStrategies:
          - onFailure:
              errors:
                - AllErrors
              action:
                type: StageRollback

    ## ──────────────────────────────────────────────────────────
    ## STAGE 3: Post-Deploy — Resolve Incidents + End Maintenance
    ## ──────────────────────────────────────────────────────────
    ## CRITICAL: This stage runs even if the Deploy stage failed.
    ## You don't want to be stuck in maintenance mode on a failed deploy.
    - stage:
        name: End Maintenance Mode
        identifier: end_maintenance_mode
        type: Custom
        ## Always run this stage regardless of prior stage outcome
        when:
          pipelineStatus: All
        spec:
          execution:
            steps:

              ## ── Step 1: Fetch open incidents that started after this pipeline began ──
              - step:
                  name: Get Open Incidents Since Deploy Started
                  identifier: get_open_incidents
                  type: Http
                  spec:
                    method: GET
                    ## Uses the reporting API so we can filter by startedAfter timestamp.
                    ## <+pipeline.startTs> is Harness's built-in pipeline start epoch (ms).
                    ## We convert ms → ISO8601 seconds using a Harness expression.
                    url: >-
                      https://api.victorops.com/api-reporting/v1/incidents?currentPhase=triggered&startedAfter=<+pipeline.startTs>
                    headers:
                      - key: X-VO-Api-Id
                        value: <+secrets.getValue("splunk_oncall_api_id")>
                      - key: X-VO-Api-Key
                        value: <+secrets.getValue("splunk_oncall_api_key")>
                    assertion: <+httpResponseCode> == 200
                    outputVariables:
                      - name: openIncidentNumbers
                        ## Extracts an array of incident numbers from the response.
                        ## These are the only incidents we'll resolve — scoped to
                        ## incidents that opened after this pipeline started.
                        value: <+json("incidents[*].incidentNumber")>
                        type: String
                  timeout: 30s
                  ## Don't abort the whole stage if this fails — still need to end maintenance
                  failureStrategies:
                    - onFailure:
                        errors:
                          - AllErrors
                        action:
                          type: Ignore
                  description: >
                    Fetches all triggered (open) incidents that started after this
                    pipeline began. Scoped to avoid resolving pre-existing incidents
                    owned by other teams.

              ## ── Step 2: Resolve those open incidents ──
              ## This runs BEFORE ending maintenance mode intentionally.
              ## Ending maintenance mode first would cause immediate paging.
              - step:
                  name: Resolve Open Incidents From Maintenance Window
                  identifier: resolve_open_incidents
                  type: Http
                  spec:
                    method: PATCH
                    url: https://api.victorops.com/api-public/v1/incidents/resolve
                    headers:
                      - key: X-VO-Api-Id
                        value: <+secrets.getValue("splunk_oncall_api_id")>
                      - key: X-VO-Api-Key
                        value: <+secrets.getValue("splunk_oncall_api_key")>
                      - key: Content-Type
                        value: application/json
                    requestBody: |-
                      {
                        "userName": "<+secrets.getValue("splunk_oncall_username")>",
                        "incidentNames": <+execution.steps.get_open_incidents.output.outputVariables.openIncidentNumbers>,
                        "message": "Auto-resolved by Harness post-deploy. Pipeline: <+pipeline.name> | RunID: <+pipeline.executionId>"
                      }
                    assertion: <+httpResponseCode> == 200
                  timeout: 30s
                  ## Don't abort on failure — still need to end maintenance mode
                  failureStrategies:
                    - onFailure:
                        errors:
                          - AllErrors
                        action:
                          type: Ignore
                  description: >
                    Resolves all open incidents that opened during this maintenance
                    window. Must run before ending maintenance mode to prevent
                    immediate paging on open incidents.

              ## ── Step 3: End Maintenance Mode ──
              ## Always runs last, even if resolve step failed.
              - step:
                  name: End Splunk On-Call Maintenance Mode
                  identifier: end_maintenance_mode_api
                  type: Http
                  spec:
                    method: PUT
                    ## Uses the instanceId captured in the pre-deploy stage
                    url: >-
                      https://api.victorops.com/api-public/v1/maintenancemode/<+pipeline.stages.start_maintenance_mode.spec.execution.steps.start_maintenance_mode_api.output.outputVariables.maintenanceModeId>/end
                    headers:
                      - key: X-VO-Api-Id
                        value: <+secrets.getValue("splunk_oncall_api_id")>
                      - key: X-VO-Api-Key
                        value: <+secrets.getValue("splunk_oncall_api_key")>
                    assertion: <+httpResponseCode> == 200
                  timeout: 30s
                  failureStrategies:
                    - onFailure:
                        errors:
                          - AllErrors
                        action:
                          type: MarkAsFailure
                  description: >
                    Ends the maintenance window. Runs after incident resolution
                    to avoid triggering pages on any remaining open incidents.

## ============================================================
## TROUBLESHOOTING NOTES
## ============================================================
##
## "incidents[*].incidentNumber returns empty"
##   → No open incidents during your window. That's fine — the resolve
##     call will no-op gracefully with an empty array.
##
## "409 on start maintenance mode"
##   → A global maintenance mode is already active in your org.
##     You can only have one global mode at a time. Switch to
##     routing-key-scoped mode, or end the existing global one first.
##
## "maintenanceModeId is null in end step"
##   → The start step failed or the instanceId wasn't captured.
##     Check the start step's output variables in the execution log.
##
## "I want to scope to multiple routing keys"
##   → Edit the names array in the start step body:
##     "names": ["payments", "api-gateway", "auth-service"]
##
## "I want to resolve ALL open incidents, not just ones from this window"
##   → Replace the GET in step 1 with:
##     GET https://api.victorops.com/api-public/v1/incidents
##     (no query params — returns everything currently open org-wide)
##     Use with caution in shared orgs.
##
## ============================================================

