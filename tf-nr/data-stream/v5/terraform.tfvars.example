# Copy this to terraform.tfvars (which should be in .gitignore) and fill in
# real values. Never commit real secrets.

aws_region       = "us-east-1"
name_prefix      = "newrelic-firehose"

# New Relic account settings
newrelic_account_id       = "REPLACE_ME"        # numeric NR account ID
newrelic_account_region   = "US"                # "US" or "EU"
newrelic_provider_api_key = "REPLACE_ME"        # NRAK-... User API key, for the Terraform provider only

# Optional: restrict the metric stream to specific namespaces.
# include_metric_filters = {
#   "AWS/EC2"    = []
#   "AWS/Lambda" = []
# }

# --- Test-matrix toggles (see variables.tf for full descriptions) ---
# Flip these to isolate which dimension is causing the stall:
# enable_customer_managed_kms = false   # true = hardened (default), false = no-KMS baseline
# s3_backup_mode              = "AllData"  # temporarily prove records reach Firehose at all
# newrelic_endpoint_variant   = "govcloud" # if your NR account is FedRAMP-designated
