"""
Editing relationships is done in two steps, on purpose:

  1. `plan-add` / `plan-remove` write a small JSON "change plan" to
     outputs/changes/ describing what *would* happen. Nothing touches
     New Relic at this point.
  2. `apply` reads a plan file, prints it for review, asks for
     confirmation (unless --yes), then executes each change one at a
     time via NerdGraph -- logging every request and result to
     outputs/logs/ and writing a results file to outputs/changes/.

This mirrors a normal change-review workflow and keeps a paper trail of
exactly what was requested, approved, and executed.
"""
from __future__ import annotations

import json
import logging
from dataclasses import asdict, dataclass
from pathlib import Path
from typing import Literal

from .logging_utils import CHANGES_DIR, ensure_output_dirs, timestamp
from .nerdgraph_client import NerdGraphClient, NerdGraphError
from .queries import CREATE_OR_REPLACE_RELATIONSHIP, DELETE_RELATIONSHIP

logger = logging.getLogger("nr_rel.relationships")

Action = Literal["add", "remove"]


@dataclass
class ChangeItem:
    action: Action
    source_guid: str
    target_guid: str
    rel_type: str
    reason: str = ""


@dataclass
class ChangePlan:
    items: list[ChangeItem]
    created_at: str
    note: str = ""

    def to_dict(self) -> dict:
        return {
            "created_at": self.created_at,
            "note": self.note,
            "items": [asdict(i) for i in self.items],
        }

    @classmethod
    def from_dict(cls, data: dict) -> "ChangePlan":
        return cls(
            created_at=data["created_at"],
            note=data.get("note", ""),
            items=[ChangeItem(**i) for i in data["items"]],
        )


def write_plan(items: list[ChangeItem], note: str = "") -> Path:
    ensure_output_dirs()
    plan = ChangePlan(items=items, created_at=timestamp(), note=note)
    path = CHANGES_DIR / f"plan_{plan.created_at}.json"
    path.write_text(json.dumps(plan.to_dict(), indent=2), encoding="utf-8")
    logger.info("Wrote change plan with %d item(s) to %s", len(items), path)
    return path


def load_plan(path: str | Path) -> ChangePlan:
    data = json.loads(Path(path).read_text(encoding="utf-8"))
    return ChangePlan.from_dict(data)


def describe_plan(plan: ChangePlan) -> str:
    lines = [f"Change plan created {plan.created_at} ({len(plan.items)} item(s))"]
    if plan.note:
        lines.append(f"Note: {plan.note}")
    for idx, item in enumerate(plan.items, 1):
        verb = "ADD " if item.action == "add" else "REMOVE"
        lines.append(
            f"  {idx}. {verb} relationship type={item.rel_type!r} "
            f"{item.source_guid} -> {item.target_guid}"
            + (f"  (reason: {item.reason})" if item.reason else "")
        )
    return "\n".join(lines)


def apply_plan(
    client: NerdGraphClient, plan: ChangePlan, dry_run: bool = True
) -> list[dict]:
    """Execute (or, if dry_run, simulate) every item in a plan.

    Returns a list of result records, each logged and eventually written
    to outputs/changes/results_<ts>.json by the CLI layer.
    """
    results: list[dict] = []
    for idx, item in enumerate(plan.items, 1):
        record = {
            "index": idx,
            "action": item.action,
            "source_guid": item.source_guid,
            "target_guid": item.target_guid,
            "rel_type": item.rel_type,
            "dry_run": dry_run,
        }
        if dry_run:
            logger.info(
                "[DRY RUN] would %s relationship %s: %s -> %s",
                item.action, item.rel_type, item.source_guid, item.target_guid,
            )
            record["status"] = "skipped_dry_run"
            results.append(record)
            continue

        query = CREATE_OR_REPLACE_RELATIONSHIP if item.action == "add" else DELETE_RELATIONSHIP
        variables = {
            "sourceEntityGuid": item.source_guid,
            "targetEntityGuid": item.target_guid,
            "type": item.rel_type,
        }
        try:
            data = client.execute(query, variables)
            key = (
                "entityRelationshipUserDefinedCreateOrReplace"
                if item.action == "add"
                else "entityRelationshipUserDefinedDelete"
            )
            errors = (data.get(key) or {}).get("errors") or []
            if errors:
                logger.error("NerdGraph reported errors for item %d: %s", idx, errors)
                record["status"] = "error"
                record["errors"] = errors
            else:
                logger.info(
                    "%s relationship %s: %s -> %s -- OK",
                    "Added" if item.action == "add" else "Removed",
                    item.rel_type, item.source_guid, item.target_guid,
                )
                record["status"] = "success"
        except NerdGraphError as exc:
            logger.error("Failed to apply item %d (%s): %s", idx, item, exc)
            record["status"] = "exception"
            record["error"] = str(exc)

        results.append(record)

    return results


def write_results(results: list[dict]) -> Path:
    ensure_output_dirs()
    path = CHANGES_DIR / f"results_{timestamp()}.json"
    path.write_text(json.dumps(results, indent=2), encoding="utf-8")
    logger.info("Wrote apply results to %s", path)
    return path
